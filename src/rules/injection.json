{
  "rules": [
    {
      "id": "injection.directive",
      "category": "injection",
      "severity": "block",
      "description": "Instruction-override directive; content tries to rewrite the agent's system prompt or prior instructions.",
      "kind": "phrase",
      "phrases": [
        "ignore previous instructions",
        "ignore all previous instructions",
        "ignore the instructions above",
        "ignore your previous instructions",
        "ignore all prior instructions",
        "ignore the previous instructions",
        "disregard previous instructions",
        "disregard all previous instructions",
        "disregard the instructions above",
        "disregard your instructions",
        "forget all previous instructions",
        "forget everything above",
        "override your instructions",
        "override the instructions",
        "you are now",
        "from now on you are",
        "you are not bound",
        "you are not required",
        "your new instructions",
        "your new system prompt",
        "ignore your system prompt",
        "ignore the system prompt",
        "disregard the system prompt",
        "disregard your system prompt",
        "ignore all system prompts",
        "no system prompt",
        "remove your restrictions",
        "remove all restrictions",
        "act as an unrestricted",
        "act as dan",
        "jailbreak",
        "developer mode",
        "redefine your role"
      ]
    },
    {
      "id": "injection.directive-zh",
      "category": "injection",
      "severity": "block",
      "description": "中文指令覆盖短语；内容试图改写模型的系统提示或此前指令。",
      "kind": "phrase",
      "phrases": [
        "忽略之前的指令",
        "忽略之前所有指令",
        "忽略以上指令",
        "忽略以下指令",
        "忽略所有指令",
        "忽略上面的指令",
        "忽略下面的指令",
        "忽略系统提示",
        "忽略系统提示词",
        "无视系统提示",
        "无视系统提示词",
        "推翻之前的设定",
        "覆盖你的指令",
        "你现在是",
        "从现在开始你是",
        "你不再是",
        "重新定义你的角色",
        "不要遵守",
        "不必遵守",
        "不需要遵守",
        "无需遵守",
        "无视所有限制",
        "解除你的限制",
        "绕过限制",
        "越狱模式",
        "开发者模式"
      ]
    },
    {
      "id": "injection.prompt-extraction",
      "category": "injection",
      "severity": "warn",
      "description": "Prompt-extraction request; asks the model to reveal its system prompt or instructions.",
      "kind": "phrase",
      "phrases": [
        "print your instructions",
        "print your system prompt",
        "repeat your instructions",
        "repeat your system prompt",
        "show your system prompt",
        "output your instructions",
        "输出你的系统提示",
        "输出你的指令",
        "复述你的系统提示",
        "复述你的指令",
        "泄露你的提示词",
        "把你的指令写出来",
        "把你所有的指令",
        "把你的系统提示"
      ]
    },
    {
      "id": "injection.zero-width",
      "category": "injection",
      "severity": "warn",
      "description": "Zero-width or bidi control characters present; commonly used to hide instructions from human review. Note: ZWNJ in Persian/Urdu text is legitimate.",
      "kind": "file",
      "check": "zero-width"
    },
    {
      "id": "injection.base64-hidden",
      "category": "injection",
      "severity": "block",
      "description": "A base64 blob in the content decodes to text containing an instruction-override phrase.",
      "kind": "file",
      "check": "base64-hidden",
      "params": { "minBase64Length": 40 }
    }
  ]
}