{
  "rules": [
    {
      "id": "token.oversize",
      "category": "token",
      "severity": "warn",
      "description": "Oversized text file; huge content inflates context and token cost.",
      "kind": "file",
      "check": "oversize",
      "params": { "maxBytes": 10485760 }
    },
    {
      "id": "token.repetition",
      "category": "token",
      "severity": "block",
      "description": "Repetitive content; a long run of one character or word is deliberate padding that wastes tokens.",
      "kind": "file",
      "check": "repetition",
      "params": { "maxCharRun": 10000, "maxWordRun": 10000 }
    },
    {
      "id": "token.base64-ratio",
      "category": "token",
      "severity": "warn",
      "description": "A large fraction of the file is base64 or otherwise encoded data disguised as configuration.",
      "kind": "file",
      "check": "base64-ratio",
      "params": { "base64RatioMinBytes": 262144, "base64RatioThreshold": 0.7 }
    },
    {
      "id": "token.comment-padding",
      "category": "token",
      "severity": "warn",
      "description": "An extremely long comment consisting mostly of filler characters; hidden padding that wastes tokens.",
      "kind": "file",
      "check": "comment-padding",
      "params": { "minCommentChars": 2000, "fillerRatio": 0.9 }
    }
  ]
}